<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hapus permanen?"
        android:textColor="@color/breeze_danger"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/deletePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="middle"
        android:maxLines="2"
        android:text="/path"
        android:textColor="@color/breeze_text"
        android:textSize="13sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/deleteInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ukuran"
        android:textColor="@color/breeze_text_dim"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/deleteAck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Saya mengerti: data akan dihapus PERMANEN dan tidak dapat dikembalikan."
        android:textColor="@color/breeze_text"
        android:textSize="12sp"
        android:buttonTint="@color/breeze_danger" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/deleteCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:text="Batal"
            android:textColor="@color/breeze_text" />

        <Button
            android:id="@+id/deleteConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_danger"
            android:enabled="false"
            android:text="HAPUS"
            android:textAllCaps="true"
            android:textColor="#ffffff"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
