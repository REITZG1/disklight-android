<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/breeze_bg"
    android:fitsSystemWindows="true">

    <!-- ══════════ Top bar ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="@color/breeze_panel">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/breeze_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="· Android"
            android:textColor="@color/breeze_text_dim"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status mode aktif -->
        <View
            android:id="@+id/rootDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/rootLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="ROOT"
            android:textColor="@color/breeze_text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ImageButton
            android:id="@+id/aboutBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/about"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <!-- ══════════ Mode selector: Normal / Shizuku (ADB) / Root ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="Mode"
            android:textColor="@color/breeze_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/modeNormalBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:text="Normal"
            android:textColor="@color/breeze_text"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/modeShizukuBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:text="Shizuku"
            android:textColor="@color/breeze_text"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/modeRootBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:text="Root"
            android:textColor="@color/breeze_text"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- ══════════ Path row ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/upBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="@string/up"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_up" />

        <EditText
            android:id="@+id/pathInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_edit"
            android:hint="/sdcard"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:singleLine="true"
            android:text="/sdcard"
            android:textColor="@color/breeze_text"
            android:textColorHint="#5f676e"
            android:textSize="14sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button"
            android:letterSpacing="0.08"
            android:text="@string/scan"
            android:textAllCaps="true"
            android:textColor="#1b1e20"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════ Quick chips ══════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <Button android:id="@+id/chipRoot"    style="@style/Filelight.Chip" android:text=" / " />
            <Button android:id="@+id/chipData"    style="@style/Filelight.Chip" android:text="/data" />
            <Button android:id="@+id/chipSystem"  style="@style/Filelight.Chip" android:text="/system" />
            <Button android:id="@+id/chipSdcard"  style="@style/Filelight.Chip" android:text="/sdcard" />
            <Button android:id="@+id/chipInternal" style="@style/Filelight.Chip" android:text="/storage/emulated/0" />
            <Button android:id="@+id/chipAndroid" style="@style/Filelight.Chip" android:text="/data/media" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ══════════ Storage info ══════════ -->
    <TextView
        android:id="@+id/storageInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:text=""
        android:textColor="@color/breeze_text_dim"
        android:textSize="11sp"
        android:typeface="monospace" />

    <!-- ══════════ Sunburst chart ══════════ -->
    <org.filelight.android.SunburstView
        android:id="@+id/sunburst"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.45"
        android:minHeight="200dp" />

    <!-- ══════════ Current folder info ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:background="@color/breeze_panel">

        <TextView
            android:id="@+id/currentInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Belum ada data — tekan PINDAI"
            android:textColor="@color/breeze_text"
            android:textSize="13sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- ══════════ Children list ══════════ -->
    <ListView
        android:id="@+id/childList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#2f343a"
        android:dividerHeight="1dp"
        android:background="@color/breeze_bg"
        android:footerDividersEnabled="false" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/empty_folder"
        android:textColor="@color/breeze_text_dim"
        android:textSize="13sp" />

    <!-- ══════════ Stats footer ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/breeze_panel">

        <TextView
            android:id="@+id/rootState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROOT AKTIF"
            android:textColor="@color/breeze_ok"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="·"
            android:textColor="@color/breeze_text_dim" />

        <TextView
            android:id="@+id/statsBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/breeze_text_dim"
            android:textSize="11sp"
            android:typeface="monospace" />
    </LinearLayout>

</LinearLayout>
